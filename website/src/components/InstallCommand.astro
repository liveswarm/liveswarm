---
import { site } from '../config';
interface Props { id: string; where: string }
const { id, where } = Astro.props;
const words = site.install.split(' ');
const head = words.slice(0, 4).join(' ');
const tail = words.slice(4).join(' ');
---

<div class="install" id={id} data-install data-where={where}>
  <code class="install-cmd" tabindex="-1"><span class="pr" aria-hidden="true">$ </span><span data-cmd>{head} <span class="cont">{tail}</span></span></code>
  <button type="button" class="copy" data-copy data-paint aria-label="Copy the install command">
    <svg class="i-copy" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"></rect><path d="M10.5 3.2v-.2a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 3v5A1.5 1.5 0 0 0 4 9.5h.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
    <svg class="i-done" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 4.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    <span data-copy-label>Copy</span>
  </button>
  <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
</div>
