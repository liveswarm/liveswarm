---
/** A still agent cursor: the same pointer and name pill the live overlay draws. Decorative. */
interface Props {
  label: string;
  hue: number;
  x?: string;
  y?: string;
  flip?: boolean;
  up?: boolean;
  term?: string;
  class?: string;
}
const { label, hue, x, y, flip = false, up = false, term, class: cls } = Astro.props;
const pos = x != null && y != null ? `left:${x};top:${y};` : '';
---

<span class:list={['lsw-cur lsw-static', cls, { 'fx-x': flip, 'fx-y': up }]} style={`--h:${hue};${pos}`} aria-hidden="true">
  <span class="lsw-drift">
    <svg class="lsw-ptr" viewBox="0 0 14 20"><path d="M0 0 L0 17.2 L4.5 13.1 L7.5 19.9 L10.4 18.6 L7.4 11.9 L13.6 11.7 Z"></path></svg>
    <span class="lsw-stack">
      <span class="lsw-pill"><i class="pd"></i><span class="nm" data-label={label}></span></span>
      {term && <span class="lsw-term ok"><i class="st"></i><span class="tx" data-label={term}></span></span>}
    </span>
  </span>
</span>
