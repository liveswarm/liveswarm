---
/** Quick start: the install line, then the three slash commands in the order to try them. */
import InstallCommand from './InstallCommand.astro';
const cmds = [
  {
    cmd: 'demo',
    title: 'See it in under a minute',
    text: 'A replay of the real Nocturne session (main agent plus 12 subagents) plays on your own screen. No setup.',
  },
  {
    cmd: 'watch',
    title: 'Your own app, any framework',
    text: 'Finds your running dev server and opens it with the cursors on top. Nothing to install in your project.',
  },
  {
    cmd: 'record',
    title: 'Share it',
    text: 'Turns your next session into a sped-up vertical and widescreen video with a small “Made with Liveswarm” mark. Needs Chrome and ffmpeg.',
  },
];
---

<section class="band how" id="how" data-scene aria-labelledby="how-title">
  <div class="wrap">
    <h2 id="how-title" data-b="type">One install. Three commands.</h2>
    <div class="how-install" id="how-install" data-b>
      <InstallCommand id="how-cmd" where="how" />
      <p>Then, in Claude Code, in this order:</p>
    </div>
    <ol class="steps cmds" id="how-steps">
      {cmds.map((c) => (
        <li data-b="drop">
          <code class="slash"><span>/liveswarm:</span>{c.cmd}</code>
          <h3>{c.title}</h3>
          <p>{c.text}</p>
        </li>
      ))}
    </ol>
    <p class="how-opt" id="how-opt" data-b>
      Optional: <code>/liveswarm:setup</code> for exact landings on Vite apps.
    </p>
    <div class="real" id="how-real" data-b>
      <p>
        The plugin listens to Claude Code’s own events, so a cursor moves only when an agent
        actually edits something.
      </p>
      <ol class="pipe" aria-label="How an edit becomes a cursor move">
        <li>An agent edits <code>Hero.tsx</code></li>
        <li>Claude Code reports the edit</li>
        <li>That agent’s cursor lands on your hero</li>
      </ol>
    </div>
  </div>
</section>
