---
/**
 * What running Liveswarm costs: measured numbers only, from ../liveswarm/docs/overhead.md
 * (one Apple Silicon Mac, Claude Code 2.1.314). Change a figure only when it is measured again.
 */
const rows = [
  { fig: '0', unit: 'tokens', what: 'Added by watching', note: 'The hooks never touch Claude’s context. The five slash commands may add about 200 tokens once per session (Claude Code’s own estimate, not confirmed).' },
  { fig: '12', unit: 'ms', pre: 'about', what: 'Per event', note: 'Hooks run in the background. Claude never waits on them.' },
  { fig: '58–62', unit: 'MB', what: 'Memory', note: 'The background service, during the 12-agent session in the video.' },
  { fig: '1.3', unit: '%', pre: 'at most', what: 'CPU', note: 'The same service, in the same session.' },
  { fig: '584', unit: 'KB', what: 'Disk', note: 'Logs for that whole session.' },
  { fig: 'Nothing', unit: '', what: 'Sent off your machine', note: 'It all stays local.' },
];
---

<section class="band cost" id="cost" data-scene aria-labelledby="cost-title">
  <div class="wrap cost-grid">
    <div class="cost-head">
      <h2 id="cost-title" data-b="type">What it costs you</h2>
      <p class="lead" data-b>
        Watching costs no tokens and no waiting. Liveswarm only listens to events Claude Code
        already sends.
      </p>
      <p class="cost-src" data-b>Measured on one Mac, with Claude Code 2.1.314.</p>
    </div>
    <dl class="meter" id="cost-meter" data-b>
      {rows.map((r) => (
        <div>
          <dt>{r.what}</dt>
          <dd>
            <span class="fig">{r.pre && <small>{r.pre}</small>}<b>{r.fig}</b>{r.unit && <i>{r.unit}</i>}</span>
            <span class="note">{r.note}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
