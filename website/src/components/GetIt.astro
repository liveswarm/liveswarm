---
import InstallCommand from './InstallCommand.astro';
import Mark from './Mark.astro';
import { site } from '../config';
---

<section class="band get ink" id="get" data-scene aria-labelledby="get-title">
  <div class="wrap">
    <div class="get-mark" aria-hidden="true">
      <Mark size={104} />
    </div>
    <h2 id="get-title" data-b="type">Stop waiting. Start watching.</h2>
    <div id="get-cta" data-b>
      <InstallCommand id="get-install" where="final" />
    </div>
    <p class="get-star" id="get-star" data-b>
      <a class="btn star" href={site.repoUrl} data-track="github_click" data-where="final">
        <svg data-paint width="17" height="17" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 .9l2.1 4.5 4.9.6-3.6 3.4.9 4.9L8 11.9l-4.3 2.4.9-4.9L1 6l4.9-.6z"></path></svg>
        Star on GitHub
        <span class="star-count" data-stars hidden></span>
      </a>
    </p>
  </div>
</section>
